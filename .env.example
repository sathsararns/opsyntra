# Copy to .env; use three different random hexadecimal passwords (URL-safe).
# These are local Docker settings, separate from backend/.env used by WSL.
COMPOSE_PROJECT_NAME=opsyntra
POSTGRES_PASSWORD=CHANGE_ME_ADMIN
ANALYTICS_OWNER_PASSWORD=CHANGE_ME_OWNER
ANALYTICS_WRITE_PASSWORD=CHANGE_ME_WRITE
ANALYTICS_READ_PASSWORD=CHANGE_ME_READ
# Source CSV is mounted read-only into model-init, never copied into an image.
OPSYNTRA_DATASET_PATH=./backend/data/raw/WA_Fn-UseC_-Telco-Customer-Churn.csv
FRONTEND_PORT=3000
API_PORT=8000
KAFKA_PORT=9092
POSTGRES_PORT=5434
MLFLOW_PORT=5000
AIRFLOW_PORT=8081
NEXT_PUBLIC_ANALYTICS_POLL_MS=5000
OPSYNTRA_ANALYTICS_TIMEZONE=Asia/Colombo
OPSYNTRA_INFERENCE_GROUP_ID=opsyntra-churn-sklearn
