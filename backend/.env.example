# Data/training and local MLflow read config.yaml and need no credentials.
# MLflow uses the configured SQLite database and local artifact directory.
# Analytics: server-side only; never prefix these with NEXT_PUBLIC_.
# Copy to .env and supply separate provisioned login credentials, or use
# ..\start-analytics.ps1 -Task setup for a dedicated local WSL instance.
OPSYNTRA_ANALYTICS_MIGRATION_URL=postgresql://opsyntra_analytics_owner:CHANGE_ME@127.0.0.1:5433/opsyntra_analytics
OPSYNTRA_ANALYTICS_WRITE_URL=postgresql://opsyntra_analytics_ingest:CHANGE_ME@127.0.0.1:5433/opsyntra_analytics
OPSYNTRA_ANALYTICS_READ_URL=postgresql://opsyntra_analytics_api:CHANGE_ME@127.0.0.1:5433/opsyntra_analytics
OPSYNTRA_ANALYTICS_TIMEZONE=Asia/Colombo
OPSYNTRA_ANALYTICS_CONNECT_TIMEOUT=10
OPSYNTRA_ANALYTICS_GROUP_ID=opsyntra-analytics-v1
# Tests MUST use a separate database. Local setup supplies these automatically.
OPSYNTRA_ANALYTICS_TEST_MIGRATION_URL=postgresql://opsyntra_analytics_owner:CHANGE_ME@127.0.0.1:5433/opsyntra_analytics_test
OPSYNTRA_ANALYTICS_TEST_WRITE_URL=postgresql://opsyntra_analytics_ingest:CHANGE_ME@127.0.0.1:5433/opsyntra_analytics_test
OPSYNTRA_ANALYTICS_TEST_READ_URL=postgresql://opsyntra_analytics_api:CHANGE_ME@127.0.0.1:5433/opsyntra_analytics_test
